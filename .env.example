# Copy to .env and fill in real values. Never commit .env.
GEMINI_API_KEY=your-key-from-google-ai-studio
GEMINI_MODEL=gemini-3.5-flash
APP_API_KEY=any-long-random-string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Local throwaway database from docker-compose.yml (used only by tests)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/elder_test
# Optional: a phone's device token, used only by scripts/check_token.py
DEVICE_TOKEN=token-printed-by-register_device

# --- Alerts (step C, ADR 0026). Leave empty to log messages instead of sending them. ---
# Any long random string; the same value as the GitHub repository secret JOBS_TOKEN.
JOBS_TOKEN=
# From @BotFather in Telegram. Also set telegram.bot_username in config/settings.toml.
TELEGRAM_BOT_TOKEN=
# Any long random string; Telegram sends it back so the service knows updates are genuine.
TELEGRAM_WEBHOOK_SECRET=
# From resend.com (API Keys).
RESEND_API_KEY=
# Optional: a phone's token, used only by scripts/simulate_phone.py
PHONE_TOKEN=
